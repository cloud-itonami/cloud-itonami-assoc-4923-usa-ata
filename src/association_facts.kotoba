(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count
            topic by-topic-count by-topic-id coverage-note]))

(defn association-covered? [association :string] :i64
  (string=? association "ata"))
(defn entry-count [association :string] :i64
  (if (association-covered? association) 2 0))
(defn valid-entry? [association :string index :i64] :i64
  (if (association-covered? association)
    (if (= index 0) 1 (if (= index 1) 1 0)) 0))

(defn entry-field [association :string index :i64 field :string]
  [:option :string]
  (if (valid-entry? association index)
    (if (= index 0)
      (cond
        (string=? field "id") (option-some-of [:option :string] "ata.founding-90-years-and-rolling")
        (string=? field "title") (option-some-of [:option :string] "ATA: 90 Years and Rolling")
        (string=? field "association") (option-some-of [:option :string] "ata")
        (string=? field "isic") (option-some-of [:option :string] "4923")
        (string=? field "country") (option-some-of [:option :string] "USA")
        (string=? field "kind") (option-some-of [:option :string] "governance-program")
        (string=? field "url") (option-some-of [:option :string] "https://www.trucking.org/news-insights/ata-90-years-and-rolling")
        (string=? field "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? field "established-date") (option-some-of [:option :string] "1933-09-23")
        (string=? field "retrieved-at") (option-some-of [:option :string] "2026-07-15")
        :else (option-none-of [:option :string]))
      (cond
        (string=? field "id") (option-some-of [:option :string] "ata.safety-policy-positions")
        (string=? field "title") (option-some-of [:option :string] "Safety (ATA Policy Positions)")
        (string=? field "association") (option-some-of [:option :string] "ata")
        (string=? field "isic") (option-some-of [:option :string] "4923")
        (string=? field "country") (option-some-of [:option :string] "USA")
        (string=? field "kind") (option-some-of [:option :string] "policy-position")
        (string=? field "url") (option-some-of [:option :string] "https://trucking.org/safety")
        (string=? field "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? field "retrieved-at") (option-some-of [:option :string] "2026-07-15")
        :else (option-none-of [:option :string])))
    (option-none-of [:option :string])))

(defn topic-count [association :string index :i64] :i64
  (if (valid-entry? association index) 1 0))
(defn topic [association :string index :i64 topic-index :i64]
  [:option :string]
  (if (valid-entry? association index)
    (if (= topic-index 0)
      (if (= index 0) (option-some-of [:option :string] "governance")
          (option-some-of [:option :string] "safety"))
      (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn by-topic-count [association :string candidate :string] :i64
  (if (association-covered? association)
    (if (string=? candidate "governance") 1
        (if (string=? candidate "safety") 1 0)) 0))
(defn by-topic-id [association :string candidate :string index :i64]
  [:option :string]
  (if (association-covered? association)
    (if (= index 0)
      (if (string=? candidate "governance") (entry-field association 0 "id")
          (if (string=? candidate "safety") (entry-field association 1 "id")
              (option-none-of [:option :string])))
      (option-none-of [:option :string]))
    (option-none-of [:option :string])))
(defn coverage-note [association :string] [:option :string]
  (if (association-covered? association)
    (option-some-of [:option :string]
      "cloud-itonami-assoc-4923-usa-ata Wave 0 (ADR-2607141700): 2 ata entries seeded with official trucking.org citations. Extend the sovereign catalog; never fabricate a rule id/url.")
    (option-none-of [:option :string])))
(defn main [] :i64 0)
